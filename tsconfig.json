{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*":             ["./*"],
      "@/components/*":  ["./components/*"],
      "@/stores/*":      ["./stores/*"],
      "@/types/*":       ["./types/*"],
      "@/utils/*":       ["./utils/*"],
      "@/composables/*": ["./composables/*"],
      "@/assets/*":      ["./assets/*"]
    }
  }
}
